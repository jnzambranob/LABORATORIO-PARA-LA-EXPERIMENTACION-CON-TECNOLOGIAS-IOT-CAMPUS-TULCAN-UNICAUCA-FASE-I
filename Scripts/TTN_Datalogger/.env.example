# ==============================================================================
# The Things Network (TTN) Data Collector Configuration
# ==============================================================================
# Copia este archivo como '.env' en este mismo directorio y completa tus credenciales.
# El archivo '.env' está en .gitignore y NO se subirá a git.

# URL base del cluster de The Things Network (nam1 para Norte/Sur América)
TTN_SERVER_URL=https://nam1.cloud.thethings.network

# API Key de The Things Network con los siguientes permisos mínimos:
# - Read application traffic (as.up.data.forward, etc.)
# - Read gateway status / traffic (gs.down.send, gateway stats)
# Formato típico: NNSXS.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX...
TTN_API_KEY=NNSXS.YOUR_API_KEY_HERE

# ID de la aplicación registrada en TTN (Console -> Applications -> ID)
TTN_APP_ID=your-application-id

# ID del Gateway registrado en TTN (Console -> Gateways -> ID)
# Ej: eui-58a0cbfffe80xxxx o tu identificador personalizado
TTN_GATEWAY_ID=your-gateway-id

# Modo de recolección:
# - continuous: Corre indefinidamente hasta presionar Ctrl+C (ideal para pruebas de hasta 5 días)
# - count: Se detiene automáticamente al alcanzar MAX_PACKETS
COLLECTION_MODE=continuous

# Número máximo de paquetes si COLLECTION_MODE=count (opcional)
MAX_PACKETS=1000

# Intervalo de consulta de estadísticas del Gateway en segundos (default: 60)
GW_STATS_INTERVAL_S=60

# Intervalo de auto-exportación periódica a CSV/Excel en segundos (0 para deshabilitar, default: 3600 = 1 hora)
AUTO_EXPORT_INTERVAL_S=3600

# Directorio de almacenamiento de base de datos y exports
DATA_DIR=data
